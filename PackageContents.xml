                    HelpFile="./Contents/docs/help.html"
                    UpgradeCode="{2D9E67A1-4B30-4C88-9F55-A1E7C2B60D74}">
  <CompanyDetails Name="Joel Cressy"
                  Url="https://github.com/jtcressy/fusion-qr-plate-addin"
                  Email="jtcressy@gmail.com"/>
  <Components Description="Fusion add-in">
    <RuntimeRequirements OS="Win64|MacOS" Platform="Fusion360" SeriesMin="" SeriesMax=""/>
    <ComponentEntry AppName="QRPlate"
                    Version="1.0.0"
                    ModuleName="./Contents/QRPlate.py"
                    AppDescription="Generate printable two-material QR code plates"
                    LoadOnAutoCADStartup="False"/>
